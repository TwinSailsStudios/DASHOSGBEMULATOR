4. Full Framebuffer Architecture

Problem: Per-scanline SPI calls = 8-9 FPS (144 transactions per frame)
Failed Attempt 1: Scanline-By-Scanline rendering

// SLOW (8-9 FPS):
void lcd_draw_line(..., uint8_t line) {
  tft.setAddrWindow(GB_X, GB_Y + line, GB_W, 1);
  tft.startWrite();
  tft.pushColors(lbuf, 160, true);  // 144 separate SPI calls!
  tft.endWrite();
}

Working Solution:

// FAST (60 FPS):
IRAM_ATTR void lcd_draw_line(..., uint8_t line) {
  uint16_t *dst = fbuf + line * GB_W;
  for(int x = 0; x < GB_W; x++) dst[x] = DMG[px[x] & 3];
  // Zero SPI calls - pure RAM write
}

void pushFrame() {
  tft.startWrite();
  tft.setAddrWindow(gbX, gbY, GB_W, GB_H);
  tft.pushColors(fbuf, GB_W * GB_H, true);  // ONE 46KB burst
  tft.endWrite();
}

Why this works:

  - CPU runs gb_run_frame() at full 240MHz with 0 SPI stalls
  - Single 46KB SPI transfer after frame = ~4ms
  - CPU only stalls once per frame instead of 144 times

Critical Mistake I made:

  After adding framebuffer, we broke it by looping:

// WRONG - defeats framebuffer purpose:
for(int y = 0; y < GB_H; y++)
  tft.pushColors(fbuf + y * GB_W, GB_W, true);  // Still 144 calls!

